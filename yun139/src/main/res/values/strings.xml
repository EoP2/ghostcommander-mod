<resources>
    <string name="app_name">Ghost Commander - 139yun plugin</string>
    <string name="app_descr">China Mobile\'s 139 personal cloud drive.</string>

    <string name="help_text">Add each one under a name of your choice; in the file manager you first pick an account, then browse its files as usual.\n\nTo add an account, paste the \"Authorization\" request header value that yun.139.com sends when you are logged in on the web (without the leading \"Basic \").</string>
    <string name="empty_accounts">No accounts yet. Tap \"Add account\" below.</string>
    <string name="btn_add_account">Add account</string>

    <string name="add_account_title">Add account</string>
    <string name="alias_label">Account name</string>
    <string name="alias_hint">e.g. Personal, Work (shows up in paths)</string>
    <string name="token_label">Authorization token</string>
    <string name="token_hint">e.g. MTAwMDA6MTM4MDAxMzgwMDA6...</string>

    <string name="btn_add">Add</string>
    <string name="btn_cancel">Cancel</string>
    <string name="btn_test">Test</string>
    <string name="btn_remove">Remove</string>

    <string name="account_phone">Phone: %1$s</string>
    <string name="confirm_remove">Remove the account \"%1$s\"? You will have to paste its token again to use it later.</string>

    <string name="status_added">Account added.</string>
