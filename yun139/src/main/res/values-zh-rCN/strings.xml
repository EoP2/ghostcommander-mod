<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">139云盘</string>
    <string name="app_descr">139云盘：中国移动个人云盘（yun.139.com），仅支持令牌登录。支持添加多个账号（各自起一个别名），账号之间请用收藏夹切换，和 ftp/sftp/smb/webdav 一致。</string>

    <string name="alias_label">账号别名</string>
    <string name="alias_hint">例如：work、个人——本地起的名字，不是手机号</string>

    <string name="help_text">请粘贴登录 yun.139.com 网页版后，浏览器请求头中 \"Authorization\" 字段的值（不含开头的 \"Basic \"）。当前仅支持令牌登录，暂不支持账号密码登录。如需添加多个 139 云盘账号，请分别为每个账号起一个别名后在此添加，添加后用收藏夹分别收藏各账号的目录即可切换。</string>
    <string name="token_label">授权令牌（Authorization）</string>
    <string name="token_hint">例如：MTAwMDA6MTM4MDAxMzgwMDA6...</string>

    <string name="add_fave_label">添加到收藏夹</string>
    <string name="comment_label">备注（可选）</string>

    <string name="btn_test">测试连接</string>
    <string name="btn_connect">确定</string>
    <string name="btn_cancel">取消</string>
    <string name="btn_delete">删除此账号</string>

    <string name="status_empty">请先粘贴令牌。</string>
    <string name="status_need_alias">请先填写账号别名。</string>
    <string name="status_reauth">这个账号需要重新绑定令牌，粘贴后点"确定"即可。</string>
    <string name="status_testing">正在测试连接…</string>
    <string name="status_ok">连接成功，账号：%1$s</string>
    <string name="status_fail">连接失败：%1$s</string>
</resources>
